# Copy to .env and fill in. .env is ignored by git, so your passwords stay on this machine.

# IP (or hostname) other devices use to reach this computer on the LAN.
# Icecast writes it into playlist links such as /radio.m3u.
RADIO_HOST=192.168.1.10

# Your music folder. The radio reads it but never writes to it, except its radio/ subfolder,
# where the play order (playlist.m3u) and state (radio-state.json) are kept.
# Windows: D:/Music   Linux/macOS: /home/me/Music
MUSIC_DIR=D:/Music

# Letters and digits only (Icecast's start script puts them into its XML config with sed).
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_PASSWORD=change-me-admin

# Password for live sources on port 8005 (BUTT, Mixxx, ffmpeg; user "source", mount /live).
# The admin panel's own «پخش زنده» button doesn't need it: it gets a one-time password from the radio.
LIVE_PASSWORD=change-me-live

# Password for the admin panel (http://<RADIO_HOST>:8001). Changing it logs every browser out.
PANEL_PASSWORD=change-me-panel

# Password for the database viewer (http://<RADIO_HOST>:8002, read-only). Letters and digits.
DB_PASSWORD=change-me-db
